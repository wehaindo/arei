<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_rfid" model="ir.ui.view">
        <field name="name">pos.config.form.rfid</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <group string="RFID Settings" name="rfid_settings">
                    <field name="rfid_enabled"/>
                    <field name="rfid_websocket_url" invisible="not rfid_enabled"/>
                    <field name="rfid_auto_add" invisible="not rfid_enabled"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
