<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="weha_pos_rfid.RFIDButton">
        <div t-att-class="'control-button ' + buttonClass" t-on-click="onClick">
            <i t-att-class="'fa ' + buttonIcon" />
            <span class="control-button-label">
                <t t-esc="buttonText"/>
            </span>
        </div>
    </t>

    <t t-name="weha_pos_rfid.ProductScreenButtons" t-inherit="point_of_sale.ProductScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons')]" position="inside">
            <RFIDButton t-if="pos.config.rfid_enabled"/>
        </xpath>
    </t>
</templates>
