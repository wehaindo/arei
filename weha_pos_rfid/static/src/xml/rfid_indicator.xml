<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    
    <!-- RFID Status Indicator Component -->
    <t t-name="weha_pos_rfid.RFIDIndicator">
        <div class="rfid-status-indicator" 
             t-att-class="connectionStatus.statusClass"
             t-on-click="onClick"
             title="Click for more info or to reconnect">
            <i t-att-class="'fa ' + connectionStatus.statusIcon" />
            <span class="rfid-status-text" t-if="!env.pos.ui.isSmall">
                <t t-esc="connectionStatus.statusText"/>
            </span>
        </div>
    </t>

    <!-- Add RFID Indicator to Navbar -->
    <t t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-rightheader')]" position="inside">
            <RFIDIndicator />
        </xpath>
    </t>

</templates>
