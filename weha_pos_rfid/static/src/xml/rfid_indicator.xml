<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    
    <!-- Patch Navbar to add RFID Indicator -->
    <t t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-leftheader')]" position="inside">
            <t t-if="pos.config.rfid_enabled">
                <button class="rfid-status-icon btn btn-light d-flex align-items-center justify-content-center" 
                        t-att-class="getRfidStatusClass()"
                        t-on-click="onRfidClick"
                        t-att-title="getRfidStatusText()">
                    <i t-att-class="getRfidStatusIcon()" />
                </button>
            </t>
        </xpath>
    </t>

</templates>
