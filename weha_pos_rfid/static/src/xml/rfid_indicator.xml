<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    
    <!-- Patch Navbar to add RFID Indicator -->
    <t t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-rightheader')]" position="inside">
            <t t-if="pos.config.rfid_enabled">
                <button class="rfid-status-indicator btn btn-light btn-lg lh-lg d-flex align-items-center gap-2 flex-shrink-0 h-100" 
                        t-att-class="getRfidStatusClass()"
                        t-on-click="onRfidClick"
                        title="RFID Reader Status - Click for details">
                    <i t-att-class="getRfidStatusIcon()" />
                    <span class="rfid-status-text d-none d-xl-inline-block text-truncate" t-if="!ui.isSmall">
                        <t t-esc="getRfidStatusText()"/>
                    </span>
                </button>
            </t>
        </xpath>
    </t>

</templates>
