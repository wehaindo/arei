<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Manufacturing Produce Wizard Form View -->
    <record id="view_mrp_produce_wizard_form" model="ir.ui.view">
        <field name="name">mrp.produce.wizard.form</field>
        <field name="model">mrp.produce.wizard</field>
        <field name="arch" type="xml">
            <form string="Produce Products">
                <header>
                    <field name="state" invisible="1"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="production_id" readonly="1"/>
                            <field name="product_id" readonly="1"/>
                            <field name="product_tracking" invisible="1"/>
                        </group>
                        <group>
                            <field name="product_uom_id" readonly="1"/>
                        </group>
                    </group>
                    
                    <!-- Step 1: Input Quantity -->
                    <group attrs="{'invisible': [('state', '!=', 'input_quantity')]}">
                        <group>
                            <label for="qty_producing"/>
                            <div class="o_row">
                                <field name="qty_producing" class="oe_inline"/>
                                <field name="product_uom_id" class="oe_inline" readonly="1"/>
                            </div>
                        </group>
                    </group>
                    
                    <!-- Step 2: Input Lot/Serial -->
                    <group attrs="{'invisible': [('state', '!=', 'input_lot')]}">
                        <group string="Finished Product Lot/Serial Number">
                            <field name="lot_producing_id" 
                                   domain="[('product_id', '=', product_id)]"
                                   attrs="{'required': [('product_tracking', 'in', ['lot', 'serial'])]}"/>
                            <field name="lot_name" 
                                   placeholder="Or enter new lot/serial number"
                                   attrs="{'invisible': [('lot_producing_id', '!=', False)]}"/>
                        </group>
                    </group>
                    
                    <!-- Step 3: Input Components -->
                    <notebook attrs="{'invisible': [('state', '!=', 'input_components')]}">
                        <page string="Components to Consume">
                            <field name="component_line_ids">
                                <tree editable="bottom">
                                    <field name="product_id" readonly="1"/>
                                    <field name="product_tracking" invisible="1"/>
                                    <field name="qty_to_consume" readonly="1"/>
                                    <field name="qty_done"/>
                                    <field name="product_uom_id" readonly="1"/>
                                    <field name="lot_id" 
                                           domain="[('product_id', '=', product_id)]"
                                           attrs="{'required': [('product_tracking', 'in', ['lot', 'serial']), ('qty_done', '>', 0)]}"/>
                                    <field name="lot_name" 
                                           placeholder="Or enter lot/serial"
                                           attrs="{'invisible': [('lot_id', '!=', False)]}"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    
                    <!-- Step 4: Confirm -->
                    <group attrs="{'invisible': [('state', '!=', 'confirm')]}">
                        <group string="Summary">
                            <label for="qty_producing"/>
                            <div>
                                <field name="qty_producing" readonly="1" class="oe_inline"/>
                                <field name="product_uom_id" readonly="1" class="oe_inline"/>
                            </div>
                            <field name="lot_producing_id" readonly="1" 
                                   attrs="{'invisible': [('product_tracking', 'not in', ['lot', 'serial'])]}"/>
                            <field name="lot_name" readonly="1"
                                   attrs="{'invisible': ['|', ('product_tracking', 'not in', ['lot', 'serial']), ('lot_producing_id', '!=', False)]}"/>
                        </group>
                    </group>
                    
                </sheet>
                <footer>
                    <button string="Back" 
                            name="action_back" 
                            type="object" 
                            class="btn-secondary"
                            attrs="{'invisible': [('state', '=', 'input_quantity')]}"/>
                    <button string="Next" 
                            name="action_next" 
                            type="object" 
                            class="btn-primary"
                            attrs="{'invisible': [('state', '=', 'confirm')]}"/>
                    <button string="Produce" 
                            name="action_produce" 
                            type="object" 
                            class="btn-primary"
                            attrs="{'invisible': [('state', '!=', 'confirm')]}"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
