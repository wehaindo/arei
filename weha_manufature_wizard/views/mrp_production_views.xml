<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Add button to Manufacturing Order form view -->
    <record id="view_mrp_production_form_inherit" model="ir.ui.view">
        <field name="name">mrp.production.form.inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_mark_done']" position="after">
                <button name="action_open_produce_wizard" 
                        type="object" 
                        string="Produce Step by Step"
                        class="oe_highlight"
                        attrs="{'invisible': [('state', 'not in', ['confirmed', 'progress'])]}"/>
            </xpath>
        </field>
    </record>

</odoo>
