<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_config_form_inventory_receiving" model="ir.ui.view">
        <field name="name">pos.config.form.inventory.receiving</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='accounting']" position="after">
                <group string="Inventory Receiving" name="inventory_receiving">
                    <field name="enable_inventory_receiving"/>
                    <field name="receiving_location_id" 
                           invisible="not enable_inventory_receiving"
                           required="enable_inventory_receiving"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
